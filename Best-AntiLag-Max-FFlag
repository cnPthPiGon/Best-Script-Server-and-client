Lighting.GlobalShadows = false
Lighting.FogEnd = 10000
Lighting.Brightness = 1.5
Lighting.ClockTime = 12

for _, effect in pairs(Lighting:GetChildren()) do
    if effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect") or effect:IsA("DepthOfFieldEffect") or effect:IsA("BlurEffect") then
        effect.Enabled = false
    end
end

Workspace.StreamingEnabled = true
Workspace.StreamingMinRadius = 128
Workspace.StreamingTargetRadius = 1024

game:GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.Automatic

if lp.Character then
    game:GetService("ContentProvider"):PreloadAsync({lp.Character})
end
lp.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    game:GetService("ContentProvider"):PreloadAsync({char})
end)

spawn(function()
    while true do
        collectgarbage("collect")
        task.wait(45)
    end
end)

local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)
mt.__index = newcclosure(function(self, idx)
    if idx == "DistanceLowerBound" then return 0 end
    return oldIndex(self, idx)
end)
setreadonly(mt, true)

local lastTime = tick()
RunService.Heartbeat:Connect(function()
    if tick() - lastTime > 0.1 then
        lastTime = tick()
        collectgarbage("step")
    end
end)
